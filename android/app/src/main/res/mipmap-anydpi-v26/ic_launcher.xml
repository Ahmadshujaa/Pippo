<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+): yellow background with the Pippo duck
     face in the safe zone, so launchers apply the same rounded mask shape
     as other apps. Devices below API 26 fall back to mipmap-*/ic_launcher.png -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/pippo_yellow" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>